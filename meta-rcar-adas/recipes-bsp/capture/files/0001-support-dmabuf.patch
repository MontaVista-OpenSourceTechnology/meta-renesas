 				errno_exit("VIDIOC_STREAMOFF");
@@ -612,6 +697,28 @@ static void start_capturing(int dev)
 			if (-1 == xioctl(fd[dev], VIDIOC_STREAMON, &type))
 				errno_exit("VIDIOC_STREAMON");
