+			/* start v4l2 device */
+			type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+			if (-1 == xioctl(fd[dev], VIDIOC_STREAMON, &type))
+				errno_exit("VIDIOC_STREAMON");
+
+			break;
 	}
 }
 
