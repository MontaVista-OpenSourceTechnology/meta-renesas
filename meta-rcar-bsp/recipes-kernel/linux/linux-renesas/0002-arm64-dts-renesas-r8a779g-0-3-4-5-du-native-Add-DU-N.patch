+
+/dts-v1/;
+#include "r8a779g0.dtsi"
+#include "white-hawk-cpu-common.dtsi"
+#include "white-hawk-common.dtsi"
+#include "white-hawk-native-common.dtsi"
+#include "whitehawk-du-native-common.dtsi"
+
+/ {
+	model = "Renesas White Hawk board based on r8a779g0";
+	compatible = "renesas,whitehawk", "renesas,r8a779g0";
+};
