From 6595e6efedfb861036a202c404523f6ace6c5075 Mon Sep 17 00:00:00 2001
From: Manh Hoang <manh.hoang.uh@bp.renesas.com>
Date: Fri, 8 May 2026 00:44:18 +0700
Subject: [PATCH 3/3] ADSP-add-build-for-ADSP-sound-driver

This patch will add ADPS alsa driver

Upstream-Status: Inappropriate [configuration]

Signed-off-by: Manh Hoang <manh.hoang.uh@bp.renesas.com>
Signed-off-by: Loc Nguyen <loc.nguyen.wt@renesas.com>
---
 sound/soc/Kconfig  | 1 +
 sound/soc/Makefile | 1 +
 2 files changed, 2 insertions(+)

diff --git a/sound/soc/Kconfig b/sound/soc/Kconfig
index 848fbae26c3b..295718dab725 100644
--- a/sound/soc/Kconfig
+++ b/sound/soc/Kconfig
@@ -100,6 +100,7 @@ source "sound/soc/uniphier/Kconfig"
 source "sound/soc/ux500/Kconfig"
 source "sound/soc/xilinx/Kconfig"
 source "sound/soc/xtensa/Kconfig"
+source "sound/soc/adsp/Kconfig"
 
 # Supported codecs
 source "sound/soc/codecs/Kconfig"
diff --git a/sound/soc/Makefile b/sound/soc/Makefile
index 507eaed1d6a1..807e94bbf5a1 100644
--- a/sound/soc/Makefile
+++ b/sound/soc/Makefile
@@ -68,3 +68,4 @@ obj-$(CONFIG_SND_SOC)	+= uniphier/
 obj-$(CONFIG_SND_SOC)	+= ux500/
 obj-$(CONFIG_SND_SOC)	+= xilinx/
 obj-$(CONFIG_SND_SOC)	+= xtensa/
+obj-$(CONFIG_SND_SOC)	+= adsp/
-- 
