 all:
 ifeq ($(KERNELDIR),)
diff --git a/rcar_hwspinlock_test.c b/rcar_hwspinlock_test.c
new file mode 100644
index 0000000..10a96eb
--- /dev/null
+++ b/rcar_hwspinlock_test.c
@@ -0,0 +1,248 @@
