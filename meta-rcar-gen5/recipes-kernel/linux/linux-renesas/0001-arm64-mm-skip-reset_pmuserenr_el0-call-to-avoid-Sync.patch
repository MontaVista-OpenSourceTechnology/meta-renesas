From f476162e5a6bdfb0dc1e4187353e7a282f4491fc Mon Sep 17 00:00:00 2001
From: Takeshi Kihara <takeshi.kihara.df@renesas.com>
Date: Sat, 6 Apr 2024 16:56:11 +0900
Subject: [PATCH 01/46] arm64: mm: skip reset_pmuserenr_el0 call to avoid Sync
 Abort

Signed-off-by: Takeshi Kihara <takeshi.kihara.df@renesas.com>
---
 arch/arm64/mm/proc.S | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/mm/proc.S b/arch/arm64/mm/proc.S
index b9ecbbae1e1a..684d69acde34 100644
--- a/arch/arm64/mm/proc.S
+++ b/arch/arm64/mm/proc.S
@@ -156,7 +156,9 @@ SYM_FUNC_START(cpu_do_resume)
 	ubfx	x11, x11, #1, #1
 	msr	oslar_el1, x11
 	reset_pmuserenr_el0 x0			// Disable PMU access from EL0
+#if 0
 	reset_amuserenr_el0 x0			// Disable AMU access from EL0
+#endif
 
 alternative_if ARM64_HAS_RAS_EXTN
 	msr_s	SYS_DISR_EL1, xzr
@@ -418,7 +420,9 @@ SYM_FUNC_START(__cpu_setup)
 	isb					// Unmask debug exceptions now,
 	enable_dbg				// since this is per-cpu
 	reset_pmuserenr_el0 x1			// Disable PMU access from EL0
+#if 0
 	reset_amuserenr_el0 x1			// Disable AMU access from EL0
+#endif
 
 	/*
 	 * Default values for VMSA control registers. These will be adjusted
-- 
2.34.1

