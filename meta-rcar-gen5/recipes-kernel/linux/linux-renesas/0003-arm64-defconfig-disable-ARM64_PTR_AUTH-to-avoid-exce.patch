From 6598bfa2b640ad19a7b7869739d1c157cf73d6ae Mon Sep 17 00:00:00 2001
From: Takeshi Kihara <takeshi.kihara.df@renesas.com>
Date: Sat, 3 May 2025 12:54:17 +0900
Subject: [PATCH 03/46] arm64: defconfig: disable ARM64_PTR_AUTH to avoid
 exceptions

Signed-off-by: Takeshi Kihara <takeshi.kihara.df@renesas.com>
---
 arch/arm64/configs/defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/defconfig b/arch/arm64/configs/defconfig
index ec0050ec24ed..7ae7deb42fac 100644
--- a/arch/arm64/configs/defconfig
+++ b/arch/arm64/configs/defconfig
@@ -77,6 +77,7 @@ CONFIG_KEXEC_FILE=y
 CONFIG_CRASH_DUMP=y
 CONFIG_XEN=y
 CONFIG_COMPAT=y
+# CONFIG_ARM64_PTR_AUTH is not set
 # CONFIG_ARM64_SVE is not set
 CONFIG_RANDOMIZE_BASE=y
 CONFIG_HIBERNATION=y
-- 
2.34.1

