From 933deb2db4ba1763b0dbb18831779155ed9fb511 Mon Sep 17 00:00:00 2001
From: Takeshi Kihara <takeshi.kihara.df@renesas.com>
Date: Thu, 11 Apr 2024 20:00:00 +0900
Subject: [PATCH 04/46] arm64: defconfig: disable ARM64_AMU_EXTN to avoid
 exceptions

Signed-off-by: Takeshi Kihara <takeshi.kihara.df@renesas.com>
---
 arch/arm64/configs/defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/defconfig b/arch/arm64/configs/defconfig
index 7ae7deb42fac..9f9eb8edf133 100644
--- a/arch/arm64/configs/defconfig
+++ b/arch/arm64/configs/defconfig
@@ -78,6 +78,7 @@ CONFIG_CRASH_DUMP=y
 CONFIG_XEN=y
 CONFIG_COMPAT=y
 # CONFIG_ARM64_PTR_AUTH is not set
+# CONFIG_ARM64_AMU_EXTN is not set
 # CONFIG_ARM64_SVE is not set
 CONFIG_RANDOMIZE_BASE=y
 CONFIG_HIBERNATION=y
@@ -1427,3 +1428,4 @@ CONFIG_ARM_SCMI_HAVE_SHMEM=y
 CONFIG_RCAR_MFIS_MBOX=y
 CONFIG_SCMI_FULL_HW_VIRTUALIZATION=y
 CONFIG_ARM_SCMI_POWER_CONTROL=y
+# CONFIG_LOCALVERSION_AUTO is not set
-- 
2.34.1

