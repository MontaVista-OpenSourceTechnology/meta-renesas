From a722d5b02e58a25c3b920e97f1157dca5b755a74 Mon Sep 17 00:00:00 2001
From: Minh Le <minh.le.aj@renesas.com>
Date: Fri, 9 May 2025 12:28:02 +0700
Subject: [PATCH 18/46] arm64: dts: renesas: r8a78000: Add I2C EEPROM device

Add EEPROM device node on I2C bus 0 for R-Car Gen5.

Signed-off-by: Minh Le <minh.le.aj@renesas.com>
---
 arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
index 903645284a1c..4a6a40f2dd41 100644
--- a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
+++ b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
@@ -120,6 +120,12 @@ &i2c0 {
 
 	status = "okay";
 	clock-frequency = <400000>;
+
+	eeprom@50 {
+		compatible = "rohm,br24g01", "atmel,24c01";
+		reg = <0x50>;
+		pagesize = <8>;
+	};
 };
 
 &i2c1 {
-- 
2.34.1

