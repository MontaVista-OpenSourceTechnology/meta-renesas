From d542abddf804b4c016f447ab52e1bd97bab1b78d Mon Sep 17 00:00:00 2001
From: Khanh Le <khanh.le.xr@renesas.com>
Date: Fri, 9 May 2025 02:01:19 +0700
Subject: [PATCH 22/46] arm64: dts: renesas: r8a78000: Add Reset node

Add Reset node for R-Car X5H.

Signed-off-by: Khanh Le <khanh.le.xr@renesas.com>
---
 arch/arm64/boot/dts/renesas/r8a78000.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r8a78000.dtsi b/arch/arm64/boot/dts/renesas/r8a78000.dtsi
index 06616fc75e99..4f23dbb92c7a 100644
--- a/arch/arm64/boot/dts/renesas/r8a78000.dtsi
+++ b/arch/arm64/boot/dts/renesas/r8a78000.dtsi
@@ -906,6 +906,11 @@ cpu_scp_hpri0: scp-shmem@60300 {
 				reg = <0x61300 0x100>;
 			};
 		};
+
+		rst: reset-controller@c1320000 {
+			compatible = "renesas,r8a78000-rst";
+			reg = <0 0xc1320000 0 0x4000>;
+		};
 	};
 
 	timer {
