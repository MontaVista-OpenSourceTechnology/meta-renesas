From 4c56ea172b2e00de5d63349c2bb376bfb4064ec6 Mon Sep 17 00:00:00 2001
From: Thanh Quan <thanh.quan.xn@renesas.com>
Date: Tue, 27 May 2025 21:49:08 +0700
Subject: [PATCH 29/46] arm64: dts: renesas: ironhide: Enable Multi-Protocol
 PHY

Enable support for the Multi-Protocol PHY controller

Signed-off-by: Thanh Quan <thanh.quan.xn@renesas.com>
---
 arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
index b49bf3cec320..d2c63970ed9b 100644
--- a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
+++ b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
@@ -136,6 +136,10 @@ &i2c1 {
 	clock-frequency = <400000>;
 };
 
+&mp_phy {
+	status = "okay";
+};
+
 &pfc {
 	hscif0_pins: hscif0 {
 		groups = "hscif0_data", "hscif0_ctrl";
-- 
2.34.1

