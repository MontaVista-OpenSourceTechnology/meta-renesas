 drivers/phy/renesas/Makefile             |   1 +
 drivers/phy/renesas/r8a78000-ether-pcs.c | 569 +++++++++++++++++++++++
 3 files changed, 577 insertions(+)
 create mode 100644 drivers/phy/renesas/r8a78000-ether-pcs.c

