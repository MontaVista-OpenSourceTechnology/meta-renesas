From c2a6d947df8ce9b9fcd6deffd826e20224a1343d Mon Sep 17 00:00:00 2001
From: Tin Tran <tin.tran.xk@renesas.com>
Date: Fri, 30 May 2025 04:35:01 +0700
Subject: [PATCH 43/46] arm64: defconfig: Update PCIe4 config

Enable CONFIG_PCIE4_RCAR_HOST by default

Signed-off-by: Tin Tran <tin.tran.xk@renesas.com>
---
 arch/arm64/configs/defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/defconfig b/arch/arm64/configs/defconfig
index f323f7d4e00e..e60a702900da 100644
--- a/arch/arm64/configs/defconfig
+++ b/arch/arm64/configs/defconfig
@@ -237,6 +237,7 @@ CONFIG_PCIE_RCAR_EP=y
 CONFIG_PCIE_DW_PLAT=y
 CONFIG_PCIE_DW_PLAT_HOST=y
 CONFIG_PCIE_DW_PLAT_EP=y
+CONFIG_PCIE4_RCAR_HOST=y
 CONFIG_PCIE6_RCAR_HOST=m
 CONFIG_PCIE6_RCAR_EP=y
 CONFIG_PCI_HOST_GENERIC=y
